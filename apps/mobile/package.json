{
  "name": "@shopperstop/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 5176",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "sh -c 'jest --ci && node --test scripts/*.test.mjs' --",
