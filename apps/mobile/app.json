{
  "expo": {
    "name": "ShopperStop",
    "slug": "shopperstop",
    "scheme": "shopperstop",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8CB46"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F8CB46",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
