+func TestMyOffer(t *testing.T) {
+	store := newID()
+	id, token := riderAt(t, store)
+	status, body := callAt(t, srv.URL, http.MethodGet, myOfferPath, token, nil)
+	if status != http.StatusNoContent || len(body) != 0 {
+		t.Fatalf("no offer: got %d %q, want 204 with no body", status, body)
+	}
+	orderID, offerID := offeredOrder(t, store, id)
+
+	status, body = callAt(t, srv.URL, http.MethodGet, myOfferPath, token, nil)
+	var o struct {
+		ID, OrderID, Number, PaymentMethod, Pincode string
+		ItemCount, EtaSeconds                       int
+		TotalCents                                  int64
+		PlacedAt, OfferedAt, ExpiresAt              time.Time
+	}
+	if status != http.StatusOK || json.Unmarshal(body, &o) != nil {
+		t.Fatalf("open offer: got %d %s, want 200", status, body)
+	}
+	if o.ID != offerID || o.OrderID != orderID || o.Number != "SS-OFFER" || o.ItemCount != 3 || o.TotalCents != 33900 ||
+		o.PaymentMethod != "cod" || o.Pincode != "560034" || o.EtaSeconds != 120 || o.PlacedAt.IsZero() || !o.ExpiresAt.After(o.OfferedAt) {
+		t.Fatalf("open offer %s: fields do not match the offer row", body)
+	}
+	want := []string{"etaSeconds", "expiresAt", "id", "itemCount", "offeredAt", "orderId", "number", "paymentMethod", "pincode", "placedAt", "totalCents"}
+	if got := keysOf(t, body); !equalStrings(got, want) {
+		t.Fatalf("open offer keys %v, want %v (no paymentStatus for cash)", got, want)
+	}
+}
+
+func equalStrings(a, b []string) bool {
+	sort.Strings(a)
+	sort.Strings(b)
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
