+func TestAcceptRacesHandClaims(t *testing.T) {
+	store := newID()
+	a, aToken := riderAt(t, store)
+	orderID, offerID := offeredOrder(t, store, a)
+	tokens := make([]string, 4)
+	for i := range tokens {
+		_, tokens[i] = riderAt(t, store)
+	}
+
+	var acceptCode int
+	codes := make([]int, len(tokens))
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(1 + len(tokens))
+	go func() {
+		defer wg.Done()
+		<-start
+		acceptCode = postCode(srv.URL, aToken, acceptPath(offerID))
+	}()
+	for i := range tokens {
+		go func() {
+			defer wg.Done()
+			<-start
+			codes[i] = claimCode(srv.URL, tokens[i], orderID)
+		}()
+	}
+	close(start)
+	wg.Wait()
+
+	all := append([]int{acceptCode}, codes...)
+	created := 0
+	for _, c := range all {
+		switch c {
+		case http.StatusCreated:
+			created++
+		case http.StatusConflict:
+		default:
+			t.Fatalf("answers %v: want only 201 and 409", all)
+		}
+	}
+	if created != 1 {
+		t.Fatalf("answers %v: want exactly one 201", all)
+	}
+	if n := countDeliveries(t, orderID); n != 1 {
+		t.Fatalf("deliveries: %d, want 1", n)
+	}
+	if n := len(coreFake.StatusChanges(orderID)); n != 1 {
+		t.Fatalf("core status changes: %d, want 1", n)
+	}
+	want := "expired"
+	if acceptCode == http.StatusCreated {
+		want = "accepted"
+	}
+	if s, _ := offerStatus(t, offerID); s != want {
+		t.Fatalf("offer %s after the race (accept answered %d), want %s", s, acceptCode, want)
+	}
+}
