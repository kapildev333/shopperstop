+const myOfferPath = "/api/rider/v1/me/offer"
+
+func acceptPath(id string) string  { return "/api/rider/v1/me/offers/" + id + "/accept" }
+func declinePath(id string) string { return "/api/rider/v1/me/offers/" + id + "/decline" }
+
+// postCode posts a bodiless request with token and returns its status, or -1
+// when the request fails. It never calls t, so goroutines may use it.
+func postCode(base, token, path string) int {
+	req, err := http.NewRequest(http.MethodPost, base+path, nil)
+	if err != nil {
+		return -1
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return -1
+	}
+	resp.Body.Close()
+	return resp.StatusCode
+}
