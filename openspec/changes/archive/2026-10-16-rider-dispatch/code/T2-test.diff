+func TestOfferAnswersLogged(t *testing.T) {
+	lines := captureLog(t)
+	store := newID()
+	id, token := riderAt(t, store)
+	acceptedOrder, accepted := offeredOrder(t, store, id)
+	if status, body := callAt(t, srv.URL, http.MethodPost, acceptPath(accepted), token, nil); status != http.StatusCreated {
+		t.Fatalf("accept: got %d %s, want 201", status, body)
+	}
+	other, otherToken := riderAt(t, store)
+	declinedOrder, declined := offeredOrder(t, store, other)
+	if status, body := callAt(t, srv.URL, http.MethodPost, declinePath(declined), otherToken, nil); status != http.StatusNoContent {
+		t.Fatalf("decline: got %d %s, want 204", status, body)
+	}
+
+	want := map[string][4]string{
+		"offer accepted":   {accepted, acceptedOrder, "SS-OFFER", id},
+		"offer declined":   {declined, declinedOrder, "SS-OFFER", other},
+		"delivery claimed": {"", acceptedOrder, "", id},
+	}
+	for msg, w := range want {
+		found := false
+		for _, l := range lines() {
+			if l["msg"] != msg || l["orderId"] != w[1] || l["riderId"] != w[3] || l["requestId"] == "" || l["level"] != "INFO" {
+				continue
+			}
+			if w[0] != "" && (l["offerId"] != w[0] || l["number"] != w[2]) {
+				continue
+			}
+			found = true
+		}
+		if !found {
+			t.Fatalf("no %q line for order %s with offerId, number, riderId and requestId", msg, w[1])
+		}
+	}
+}
