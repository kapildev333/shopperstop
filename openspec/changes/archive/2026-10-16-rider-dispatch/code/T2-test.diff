+func TestAcceptOffer(t *testing.T) {
+	store := newID()
+	id, token := riderAt(t, store)
+	orderID, offerID := offeredOrder(t, store, id)
+
+	status, body := callAt(t, srv.URL, http.MethodPost, acceptPath(offerID), token, nil)
+	var d deliveryJSON
+	if status != http.StatusCreated || json.Unmarshal(body, &d) != nil || d.Status != "assigned" || d.OrderID != orderID {
+		t.Fatalf("accept: got %d %s, want 201 with an assigned delivery of the order", status, body)
+	}
+	if s, answered := offerStatus(t, offerID); s != "accepted" || !answered {
+		t.Fatalf("offer after accept: %s (answered %v), want accepted", s, answered)
+	}
+	changes := coreFake.StatusChanges(orderID)
+	if len(changes) != 1 || changes[0].Status != "out_for_delivery" || changes[0].Actor.Type != "rider" || changes[0].Actor.ID != id {
+		t.Fatalf("core status changes %+v, want one out_for_delivery by the rider", changes)
+	}
+}
