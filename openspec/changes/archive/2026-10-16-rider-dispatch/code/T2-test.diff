+// offeredOrder adds a ready order at store and offers it to riderID, open for 30 s.
+func offeredOrder(t *testing.T, store, riderID string) (orderID, offerID string) {
+	t.Helper()
+	o := addOrder(t, store, "ready", time.Date(2026, 10, 16, 9, 0, 0, 0, time.UTC))
+	return o.ID, insertOffer(t, riderID, store, o.ID, time.Now().Add(30*time.Second))
+}
