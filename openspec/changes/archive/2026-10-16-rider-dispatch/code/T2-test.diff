+func TestAcceptRefusals(t *testing.T) {
+	store := newID()
+	id, token := riderAt(t, store)
+	otherID, _ := riderAt(t, store)
+	othersOrder, othersOffer := offeredOrder(t, store, otherID)
+	expiredOrder := addOrder(t, store, "ready", time.Date(2026, 10, 16, 9, 0, 0, 0, time.UTC))
+	expiredOffer := insertOffer(t, id, store, expiredOrder.ID, time.Now().Add(-time.Second))
+	before := coreFake.Calls(claimRoute)
+
+	status, body := callAt(t, srv.URL, http.MethodPost, acceptPath(othersOffer), token, nil)
+	expectError(t, "another rider's offer", status, body, http.StatusNotFound, "not_found")
+	status, body = callAt(t, srv.URL, http.MethodPost, acceptPath(unknownUUID), token, nil)
+	expectError(t, "unknown offer", status, body, http.StatusNotFound, "not_found")
+	status, body = callAt(t, srv.URL, http.MethodPost, acceptPath("not-a-uuid"), token, nil)
+	expectError(t, "non-uuid offer", status, body, http.StatusNotFound, "not_found")
+	status, body = callAt(t, srv.URL, http.MethodPost, acceptPath(expiredOffer), token, nil)
+	expectError(t, "expired offer", status, body, http.StatusConflict, "conflict")
+
+	if n := countDeliveries(t, othersOrder) + countDeliveries(t, expiredOrder.ID); n != 0 {
+		t.Fatalf("deliveries after the refusals: %d, want 0", n)
+	}
+	if got := coreFake.Calls(claimRoute) - before; got != 0 {
+		t.Fatalf("core received %d status calls, want 0", got)
+	}
+}
