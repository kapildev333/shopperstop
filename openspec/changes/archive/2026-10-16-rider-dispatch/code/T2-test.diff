+func TestAcceptRacesDecline(t *testing.T) {
+	store := newID()
+	id, token := riderAt(t, store)
+	_, offerID := offeredOrder(t, store, id)
+
+	var accept, decline int
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() { defer wg.Done(); <-start; accept = postCode(srv.URL, token, acceptPath(offerID)) }()
+	go func() { defer wg.Done(); <-start; decline = postCode(srv.URL, token, declinePath(offerID)) }()
+	close(start)
+	wg.Wait()
+
+	s, _ := offerStatus(t, offerID)
+	switch {
+	case accept == http.StatusCreated && decline == http.StatusConflict && s == "accepted":
+	case decline == http.StatusNoContent && accept == http.StatusConflict && s == "declined":
+	default:
+		t.Fatalf("accept %d, decline %d, offer %s: want exactly one to succeed and the status to match it", accept, decline, s)
+	}
+}
+
+func TestDeclineOnce(t *testing.T) {
+	store := newID()
+	id, token := riderAt(t, store)
+	otherID, _ := riderAt(t, store)
+	_, offerID := offeredOrder(t, store, id)
+	_, othersOffer := offeredOrder(t, store, otherID)
+
+	if status, body := callAt(t, srv.URL, http.MethodPost, declinePath(offerID), token, nil); status != http.StatusNoContent {
+		t.Fatalf("decline: got %d %s, want 204", status, body)
+	}
+	if s, answered := offerStatus(t, offerID); s != "declined" || !answered {
+		t.Fatalf("offer after decline: %s (answered %v), want declined", s, answered)
+	}
+	status, body := callAt(t, srv.URL, http.MethodPost, declinePath(offerID), token, nil)
+	expectError(t, "second decline", status, body, http.StatusConflict, "conflict")
+	status, body = callAt(t, srv.URL, http.MethodPost, acceptPath(offerID), token, nil)
+	expectError(t, "accept after decline", status, body, http.StatusConflict, "conflict")
+	status, body = callAt(t, srv.URL, http.MethodPost, declinePath(othersOffer), token, nil)
+	expectError(t, "decline of another rider's offer", status, body, http.StatusNotFound, "not_found")
+	status, body = callAt(t, srv.URL, http.MethodPost, declinePath(unknownUUID), token, nil)
+	expectError(t, "decline of an unknown offer", status, body, http.StatusNotFound, "not_found")
+}
