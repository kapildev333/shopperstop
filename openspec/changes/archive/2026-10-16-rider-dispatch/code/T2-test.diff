+func TestAcceptCoreFails(t *testing.T) {
+	store := newID()
+	id, token := riderAt(t, store)
+	orderID, offerID := offeredOrder(t, store, id)
+	coreFake.FailRoute(claimRoute, http.StatusInternalServerError)
+	t.Cleanup(func() { coreFake.FailRoute(claimRoute, 0) })
+
+	status, body := callAt(t, srv.URL, http.MethodPost, acceptPath(offerID), token, nil)
+	expectError(t, "accept with core failing", status, body, http.StatusBadGateway, "internal")
+	if n := countDeliveries(t, orderID); n != 0 {
+		t.Fatalf("deliveries after core failed: %d, want 0", n)
+	}
+	if s, _ := offerStatus(t, offerID); s != "offered" {
+		t.Fatalf("offer after core failed: %s, want offered", s)
+	}
+	coreFake.FailRoute(claimRoute, 0)
+	if status, body := callAt(t, srv.URL, http.MethodPost, acceptPath(offerID), token, nil); status != http.StatusCreated {
+		t.Fatalf("retry after core recovered: got %d %s, want 201", status, body)
+	}
+}
