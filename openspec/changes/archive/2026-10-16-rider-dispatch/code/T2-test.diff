+func TestHandClaimWhileOffered(t *testing.T) {
+	store := newID()
+	a, aToken := riderAt(t, store)
+	_, bToken := riderAt(t, store)
+	orderID, offerID := offeredOrder(t, store, a)
+
+	if status, body := callAt(t, srv.URL, http.MethodPost, claimPath, bToken, map[string]string{"orderId": orderID}); status != http.StatusCreated {
+		t.Fatalf("hand claim of an offered order: got %d %s, want 201", status, body)
+	}
+	status, body := callAt(t, srv.URL, http.MethodPost, acceptPath(offerID), aToken, nil)
+	expectError(t, "accept after the hand claim", status, body, http.StatusConflict, "conflict")
+	if s, _ := offerStatus(t, offerID); s != "expired" {
+		t.Fatalf("offer after losing to a hand claim: %s, want expired", s)
+	}
+	if n := countDeliveries(t, orderID); n != 1 {
+		t.Fatalf("deliveries: %d, want 1", n)
+	}
+	if n := len(coreFake.StatusChanges(orderID)); n != 1 {
+		t.Fatalf("core status changes: %d, want 1", n)
+	}
+}
