+func TestMyOfferNoneWhenExpiredOrClaimed(t *testing.T) {
+	store := newID()
+	expiredRider, expiredToken := riderAt(t, store)
+	insertOffer(t, expiredRider, store, newID(), time.Now().Add(-time.Second))
+	claimedRider, claimedToken := riderAt(t, store)
+	other, _ := riderAt(t, store)
+	orderID := newID()
+	insertOffer(t, claimedRider, store, orderID, time.Now().Add(30*time.Second))
+	insertDeliveryOf(t, other, store, orderID)
+
+	for name, token := range map[string]string{"expired": expiredToken, "claimed by another rider": claimedToken} {
+		if status, body := callAt(t, srv.URL, http.MethodGet, myOfferPath, token, nil); status != http.StatusNoContent {
+			t.Fatalf("%s offer: got %d %s, want 204", name, status, body)
+		}
+	}
+}
