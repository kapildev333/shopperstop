+// insertDeliveryOf inserts an assigned delivery of orderID by riderID straight into the table.
+func insertDeliveryOf(t *testing.T, riderID, store, orderID string) {
+	t.Helper()
+	_, err := testPool.Exec(t.Context(),
+		`insert into deliveries (order_id, order_number, store_id, rider_id, customer_name, address_line1, address_pincode,
+			total_cents, payment_method, item_count, items)
+		 values ($1, 'SS-OFFER', $2, $3, 'Demo Customer', '12 80 Feet Rd', '560034', 33900, 'cod', 3, '[]')`,
+		orderID, store, riderID)
+	if err != nil {
+		t.Fatal(err)
+	}
+}
