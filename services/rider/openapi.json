{
  "openapi": "3.1.0",
  "info": {
    "title": "ShopperStop rider API",
    "version": "0.3.0",
    "description": "The rider service: the riders who deliver orders, their sign-in and sessions, and the staff routes that manage them. Every error is the envelope {\"error\": {code, message, field?}}. Routes that need a signed-in rider or staff user take Authorization: Bearer <token>: a rider's token from sign-in, or a staff token that core issued and this service checks with core."
  },
  "servers": [
    {
      "url": "/api/rider/v1"
    }
  ],
  "tags": [
    {
      "name": "platform",
      "description": "Service health: liveness and readiness."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealthz",
        "summary": "Liveness",
        "description": "Answers 200 whenever the process is up. Does not touch the database.",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadyz",
        "summary": "Readiness",
        "description": "Answers 200 when the database answers a ping within 2 seconds. Answers 503 with code internal otherwise.",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "The database answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "The database did not answer within 2 seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "internal",
                    "message": "database not ready"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A rider's token from sign-in, or a staff token from core, sent as Authorization: Bearer <token>."
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "validation",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "conflict",
                  "rate_limited",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
