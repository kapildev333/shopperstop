  "info": {
    "name": "ShopperStop rider API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The rider service: the riders who deliver orders, their sign-in and sessions, and the staff routes that manage them. Every error is the envelope {\"error\": {code, message, field?}}. Routes that need a signed-in rider or staff user take Authorization: Bearer <token>: a rider's token from sign-in, or a staff token that core issued and this service checks with core.",
      "type": "text/plain"
    }
  }
